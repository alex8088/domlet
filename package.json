{
  "name": "domlet",
  "version": "1.0.0",
  "description": "A tiny, dependency-free DOM builder with CSS selector syntax, nested elements, and element references.",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.12.4",
  "author": "Alex Wei",
  "license": "MIT",
  "homepage": "https://github.com/alex8088/domlet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex8088/domlet.git"
  },
  "bugs": {
    "url": "https://github.com/alex8088/domlet/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && rollup -c rollup.config.ts --configPlugin typescript",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck.only"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.19.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "rollup": "^4.64.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-rm": "^1.0.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
